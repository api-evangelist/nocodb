  "info": {
    "_postman_id": "afa3b533-d45f-4c2e-ac0b-acf5c41918cc",
    "name": "NocoDB Data Attachments Links API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "RESTful API for querying and manipulating records across tables and views in any NocoDB base. Supports full CRUD operations on rows, filtering via where-clause operators, pagination, sorting, field selection, and bulk operations. Available in v2 and v3; v3 adds quoted-value support for special characters in query parameters.\n\nContact Support:\n Name: NocoDB",
      "type": "text/plain"
    }
  }
