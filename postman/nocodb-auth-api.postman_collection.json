  "info": {
    "_postman_id": "790a83f3-38d8-4fda-93b0-2947ac605051",
    "name": "NocoDB Data Attachments Auth API",
    "description": "RESTful API for querying and manipulating records across tables and views in any NocoDB base. Supports full CRUD operations on rows, filtering via where-clause operators, pagination, sorting, field selection, and bulk operations. Available in v2 and v3; v3 adds quoted-value support for special characters in query parameters.\n\nContact Support:\n Name: NocoDB",
